---
const { pathname } = Astro.url;
const isActive = (path: string) => pathname === path || pathname === path + '/';
---
<header class="site-header">
  <div class="container">
    {/* Interim mark: wordmark with a Mameluke sword beneath, while the logo is in progress. */}
    <a href="/" class="brand" aria-label="Resolute Ambitions home">
      <span class="brand-text">Resolute Ambitions</span>
      <svg class="brand-blade" viewBox="8 12 442 84" aria-hidden="true">
        <path d="M 98 51 C 220 49, 332 42, 446 16 C 354 55, 232 69, 98 69 Z" fill="currentColor"/>
        <path d="M 110 60 C 200 59, 276 55, 344 46" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
        <rect x="87" y="35" width="8" height="50" rx="3" fill="currentColor"/>
        <circle cx="91" cy="32" r="7.5" fill="currentColor"/>
        <circle cx="91" cy="88" r="7.5" fill="currentColor"/>
        <path d="M 91 48 L 104 60 L 91 72 L 78 60 Z" fill="currentColor"/>
        <path d="M 80 51 C 62 50, 44 52, 31 57 C 23 60, 17 66, 13 74 L 24 82 C 28 76, 33 73, 41 71.5 C 56 69.5, 68 69, 80 69 Z"
              fill="#fff" stroke="currentColor" stroke-width="3.6" stroke-linejoin="round"/>
        <circle cx="47" cy="61.5" r="3.5" fill="currentColor"/>
        <circle cx="65" cy="60" r="3.5" fill="currentColor"/>
        <circle cx="16" cy="80" r="8.5" fill="currentColor"/>
        <circle cx="16" cy="80" r="2.8" fill="#fff"/>
      </svg>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/our-story" class={isActive('/our-story') ? 'active' : ''}>Our Story</a>
      <a href="/how-it-works" class={isActive('/how-it-works') ? 'active' : ''}>How It Works</a>
      <a href="/apply" class={isActive('/apply') ? 'active' : ''}>Apply</a>
      <a href="/for-schools-and-units" class={isActive('/for-schools-and-units') ? 'active' : ''}>For Schools &amp; Units</a>
      <a href="/give" class="btn btn-give">Give</a>
    </nav>
  </div>
</header>

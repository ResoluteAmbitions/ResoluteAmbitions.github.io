---
const { pathname } = Astro.url;
const isActive = (path: string) => pathname === path || pathname === path + '/';
---
<header class="site-header">
  <div class="ribbon" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
  <div class="container">
    <a href="/" class="brand" aria-label="Resolute Ambitions home">
      <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="6" fill="#002F6C"/>
        <path d="M32 10 L48 22 L48 38 C48 48 32 56 32 56 C32 56 16 48 16 38 L16 22 Z"
              fill="none" stroke="#FAFAF7" stroke-width="3" stroke-linejoin="round"/>
        <path d="M24 32 L30 38 L42 24" fill="none" stroke="#FAFAF7"
              stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="brand-text">Resolute Ambitions</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/our-story" class={isActive('/our-story') ? 'active' : ''}>Our Story</a>
      <a href="/how-it-works" class={isActive('/how-it-works') ? 'active' : ''}>How It Works</a>
      <a href="/apply" class={isActive('/apply') ? 'active' : ''}>Apply</a>
      <a href="/for-schools-and-units" class={isActive('/for-schools-and-units') ? 'active' : ''}>For Schools &amp; Units</a>
      <a href="/give" class="btn btn-give">Give</a>
    </nav>
  </div>
</header>

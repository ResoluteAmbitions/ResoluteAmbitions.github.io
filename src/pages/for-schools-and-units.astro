---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
---
<Base color="space" title="For Schools and Units" description="For JROTC instructors, school counselors, ROTC staff, financial aid offices, base education offices and unit leaders.">
  <section class="page-hero">
    <div class="container">
      <h1>One more door you can open for your people.</h1>
      <p>
        For JROTC instructors, school counselors and ROTC staff, and for base education offices, unit leaders and advisors.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container cols">
      <div>
        <h2>Refer a candidate</h2>
        <p>
          We fund two groups: high school juniors and seniors headed to a college with ROTC or in service academy prep, and active-duty enlisted members of any branch pursuing the degree they need to commission.
        </p>
        <p>
          If you work with someone who fits, point them to <a href="/apply">our Apply page</a>. Plain-language eligibility is on <a href="/how-it-works">How it works</a>.
        </p>
        {/* TODO(content): one-page PDF and short link for gatekeepers to hand over. */}
      </div>
      <Photo hint="A counselor or JROTC instructor with students" ratio="4 / 3" />
    </div>
  </section>

  <section class="block">
    <div class="container">
      <div class="section-head">
        <h2>Host a workshop</h2>
        <p>
          We offer informational workshops on officer career pathways and on scholarship and commissioning applications.
        </p>
        <div class="actions">
          <a href="mailto:info@resoluteambitions.com?subject=Workshop" class="btn">Ask us to bring one to your school or unit</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cols">
      <Photo hint="A financial aid office or campus building" ratio="4 / 3" />
      <div>
        <h2>For financial aid offices</h2>
        <p>
          Scholarship money is paid directly to the school on the student's behalf, never to the individual. We verify enrollment and academic progress before every payment.
        </p>
        <p>
          <a href="mailto:info@resoluteambitions.com?subject=Financial%20aid%20office">Email us</a> to set up how your office receives funds.
        </p>
      </div>
    </div>
  </section>
</Base>

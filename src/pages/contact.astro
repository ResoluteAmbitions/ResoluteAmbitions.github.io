---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Get in touch with Resolute Ambitions.">
  <section class="page-hero">
    <div class="container">
      <h1>Get in touch.</h1>
      <p>Whether you want to give, apply, partner, or understand the mission better, we'd like to hear from you.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Email</h2>
        <p>
          General inquiries, scholarship questions, partnerships, and press:
          <br />
          <a href="mailto:info@resoluteambitions.com">info@resoluteambitions.com</a>
        </p>
      </div>
      <div class="cards">
        <div class="card">
          <h3>Prospective applicants</h3>
          <p>Applications are not yet open. See <a href="/apply">Apply</a> for status, or email us to be notified when the first cycle opens.</p>
        </div>
        <div class="card">
          <h3>Donors and sponsors</h3>
          <p>Online giving will open on our <a href="/give">Give page</a>. For corporate sponsorships, matching gifts or foundation grants, email <a href="mailto:info@resoluteambitions.com">info@resoluteambitions.com</a>.</p>
        </div>
        <div class="card">
          <h3>Board service and volunteers</h3>
          <p>We are building our board and selection committee, especially educators, veterans and financial professionals. If that's you, we'd like to talk.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

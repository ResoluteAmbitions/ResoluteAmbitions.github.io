---
import Base from '../layouts/Base.astro';
---
<Base title="Newsletter" description="Sign up for Resolute Ambitions updates.">
  <section class="band band-navy page-intro">
    <div class="container">
      <span class="bar"></span>
      <h1>Stay in the loop.</h1>
      <p class="lede">
        Milestone updates on scholarship cycles, recipients and the mission.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="container">
      {/* TODO: embed the signup form once a newsletter provider is chosen. */}
      <div class="pull">
        Online signup is coming soon. Until then, <a href="mailto:info@resoluteambitions.com?subject=Newsletter">email us</a> and we will add you to the list.
      </div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import GiveStrip from '../components/GiveStrip.astro';
---
<Base title="Newsletter" description="Sign up for Resolute Ambitions updates.">
  <section class="page-hero">
    <div class="container">
      <h1>Stay in the loop.</h1>
      <p>Milestone updates on scholarship cycles, recipients and the mission.</p>
    </div>
  </section>
  <GiveStrip />

  <section class="section">
    <div class="container">
      <div class="section-head">
        {/* TODO: embed the signup form once a newsletter provider is chosen. */}
        <p>Online signup is coming soon. Until then, email us and we will add you to the list.</p>
        <div class="actions">
          <a href="mailto:info@resoluteambitions.com?subject=Newsletter" class="btn">Email us to join</a>
        </div>
      </div>
    </div>
  </section>
</Base>

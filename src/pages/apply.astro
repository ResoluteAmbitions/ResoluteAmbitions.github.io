---
import Base from '../layouts/Base.astro';
---
<Base title="Apply" description="Apply for a Resolute Ambitions scholarship for future U.S. military officers.">
  <section class="page-intro">
    <div class="container">
      <div class="eyebrow dark">Apply</div>
      <h1>Applications are not yet open.</h1>
      <p class="lede">
        We will publish the application form and timeline here once 501(c)(3) status is granted and the inaugural scholarship cycle is funded.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <!-- TODO(content): application steps, timeline, and form. Source: docs/messaging/. -->
      <h2>Who can apply</h2>
      <ul class="checked">
        <li>High school juniors and seniors headed to accredited colleges or universities with ROTC programs.</li>
        <li>Active-duty enlisted service members pursuing undergraduate education for officer commissioning.</li>
      </ul>
      <p>Full eligibility and selection criteria are on <a href="/how-it-works">How It Works</a>.</p>

      <h2>Get notified</h2>
      <p>
        <a href="/newsletter">Join the newsletter</a> or <a href="mailto:info@resoluteambitions.com">email us</a> and we will let you know when applications open.
      </p>
    </div>
  </section>
</Base>

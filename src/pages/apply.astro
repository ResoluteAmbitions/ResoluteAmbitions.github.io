---
import Base from '../layouts/Base.astro';
import HeroGive from '../components/HeroGive.astro';
import Photo from '../components/Photo.astro';
---
<Base color="orange" title="Apply" description="Scholarships for high school students and enlisted service members pursuing a military officer commission.">
  <section class="page-hero">
    <div class="container">
      <h1>Apply</h1>
      <p>
        Applications are not yet open. We will publish the application form and timeline here once the first scholarship cycle is funded.
      </p>
      <HeroGive />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Who can apply</h2>
        <p>U.S. citizens or permanent residents who show a genuine intent to become military officers.</p>
      </div>
      <div class="cards">
        <div class="card">
          <Photo hint="A high school student headed to ROTC, with family" ratio="3 / 2" />
          <h3>High school students and families</h3>
          <p class="hook">“You chose to lead. We'll help you get there without the debt.”</p>
          <p>Juniors and seniors headed to a college with ROTC, or in service academy prep.</p>
        </div>
        <div class="card">
          <Photo hint="An enlisted service member in class or studying" ratio="3 / 2" />
          <h3>Enlisted service members</h3>
          <p class="hook">“You already answered the call. Now lead.”</p>
          <p>Active-duty enlisted members of any branch pursuing the degree they need to commission, through programs such as Green to Gold, STA-21 or OCS/OTS.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <div class="section-head">
        {/* TODO(content): application steps, required documents, and timeline. */}
        <h2>What we look for</h2>
        <p>A competitive, merit-based review. Financial need is one of the criteria, along with:</p>
      </div>
      <ul class="bars bars-center">
        <li>Academic achievement and potential</li>
        <li>Commitment to military service</li>
        <li>Leadership</li>
        <li>Recommendations</li>
        <li>A personal statement</li>
      </ul>
      <div class="section-head" style="margin-top: 3rem;">
        <p>Scholarships can cover tuition, fees, room and board, books and testing costs, paid directly to your school. <a href="/how-it-works">How it works</a></p>
      </div>
    </div>
  </section>

  <section class="section block-center">
    <div class="container">
      <h2>Get notified</h2>
      <p>Join the newsletter or email us and we will tell you when applications open.</p>
      <div class="actions">
        <a href="/newsletter" class="btn">Join the newsletter</a>
        <a href="mailto:info@resoluteambitions.com?subject=Applications" class="btn">Email us</a>
      </div>
    </div>
  </section>
</Base>

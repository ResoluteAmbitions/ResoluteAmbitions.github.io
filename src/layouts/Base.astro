---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  /** The page's color, drawn from the services' official colors. */
  color?: 'olive' | 'navy' | 'gold' | 'orange' | 'red' | 'black';
}

const {
  title,
  color = 'navy',
  description = 'Resolute Ambitions gives scholarships to future military officers so they don\'t start their service in debt.',
} = Astro.props;

const siteUrl = 'https://staging.resoluteambitions.com';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <title>{title} — Resolute Ambitions</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={`${title} — Resolute Ambitions`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,800&family=Public+Sans:wght@400;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <Header />
  <main id="main" class={`c-${color}`}>
    <slot />
  </main>
  <Footer />
</body>
</html>
